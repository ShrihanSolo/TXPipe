+# The DESC metadetect v1.1 DP2 analysis (analysis_desc_metadetect_1.1.yml) plus
+# TXMeanShearSurveyProperties, the mean shear in bins of survey property maps.
+#
+# The outputs go in the same directory as the base analysis, so with
+# resume: true an existing run only adds the new stage. From the repo root:
+#   ceci examples/dp2/desc_metadetect/analysis_desc_metadetect_and_sp_1.1.yml
+
 # Stages to run
 # Processors for PZ stages. There's a bug in rail_base logging
 # that crashes if you use too many. PR in progress.
@@ -38,6 +45,8 @@ stages:
     threads_per_process: 32
   - name: TXDiagnosticQuantiles
   - name: TXPSFMaps
+  - name: TXMeanShearSurveyProperties   # Mean shear vs survey property maps
