diff --git a/examples/dp2/desc_metadetect/config_desc_metadetect_1.1.yml b/examples/dp2/desc_metadetect/config_desc_metadetect_and_sp_1.1.yml
index 07786af0..79472e7e 100644
--- a/examples/dp2/desc_metadetect/config_desc_metadetect_1.1.yml
+++ b/examples/dp2/desc_metadetect/config_desc_metadetect_and_sp_1.1.yml
@@ -1,3 +1,4 @@
+# config_desc_metadetect_1.1.yml plus a section for TXMeanShearSurveyProperties.
 global:
     chunk_rows: 1000000
     nside: 2048
@@ -258,3 +259,22 @@ TXSmokescreenBlinding:
     b0: 0.95  ## TXPipe theory model lens bias, of the form b0/growth
     seed: "Boitata was here"
     delete_unblinded: true
+
+
+TXMeanShearSurveyProperties:
+    nbins: 20
+    min_count: 50
+    outlier_fraction: 0.05
+    delta_gamma: 0.02      # as in TXComputeShearCalibrationScalarMetadetectDP2
+    # Empty list: test every map; otherwise list names, e.g. ["psf/g1_2D"].
+    properties: []
+    # Only the non-tomographic PSF maps from TXPSFMaps.
+    psf_map_bins: ["2D"]
+    # Directory of DP2 survey property maps (.hs healsparse files). They are
+    # not in the data registry yet; dp2_run/convert_dp2_sp_maps.py on the
+    # fork makes them from the DP2 butler repo at NERSC. With "" only the
+    # PSF maps are tested.
+    external_maps_dir: ""
+    bands: [i]
+    map_plot_nside: 256
+    projection: McBryde
